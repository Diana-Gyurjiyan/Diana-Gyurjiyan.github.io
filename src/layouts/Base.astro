---
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '@fontsource-variable/inter';
import '../styles/global.css';
import { langs, ui, sections, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  /** Home page: the bordeaux block runs under the top bar. */
  hero?: boolean;
}

const { lang, title, description, hero = false } = Astro.props;
const t = ui[lang];
const path = Astro.url.pathname;
// Same page in the other language: swap only the /en or /nl prefix.
const rest = path.replace(/^\/(en|nl)(?=\/|$)/, '') || '/';
const base = `/${lang}`;
const pageTitle = title ? `${title} · ${t.siteTitle}` : `${t.siteTitle} · ${t.tagline}`;
const pageDescription = description ?? t.tagline;

const links = [
  { href: `${base}/`, label: t.nav.home },
  { href: `${base}/about/`, label: t.nav.about },
  ...sections.map((s) => ({ href: `${base}/${s.slug}/`, label: t.nav[s.nav] })),
];
const isActive = (href: string) => (href === `${base}/` ? path === href : path.startsWith(href));
const canonical = new URL(path, Astro.site);
---

<!doctype html>
<html lang={lang} data-theme="light" data-sidebar="open">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical} />
    {langs.map((l) => <link rel="alternate" hreflang={l} href={new URL(`/${l}${rest}`, Astro.site)} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(`/en${rest}`, Astro.site)} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta name="color-scheme" content="light dark" />

    <!-- Runs before first paint, so there is no flash of the wrong theme or sidebar state. -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var theme = null;
        var sidebar = null;
        try {
          theme = localStorage.getItem('theme');
          sidebar = localStorage.getItem('sidebar');
        } catch (e) {}
        if (theme !== 'light' && theme !== 'dark') {
          theme = window.matchMedia && matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        // On small screens the menu is a drawer that always starts closed.
        var wide = window.innerWidth >= 1100;
        if (!wide) sidebar = 'closed';
        else if (sidebar !== 'open' && sidebar !== 'closed') sidebar = 'open';
        root.setAttribute('data-theme', theme);
        root.setAttribute('data-sidebar', sidebar);
      })();
    </script>
  </head>
  <body class={hero ? 'has-hero' : undefined}>
    <a class="skip" href="#main">{t.ui.skip}</a>

    <div class="shell">
      <aside class="sidebar" id="sidebar" aria-label={t.ui.navLabel}>
        <div class="sb-inner">
          <div class="sb-head">
            <a class="mono" href={`${base}/`} aria-label={t.siteTitle}>DG</a>
            <button class="icon-btn" type="button" data-sidebar-toggle aria-controls="sidebar" aria-expanded="true" aria-label={t.ui.closeMenu}>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
            </button>
          </div>
          <nav>
            <ul class="nav">
              {links.map((l) => (
                <li><a href={l.href} aria-current={isActive(l.href) ? 'page' : undefined}>{l.label}</a></li>
              ))}
            </ul>
          </nav>
          <p class="sb-foot">© {new Date().getFullYear()} {t.siteTitle}</p>
        </div>
      </aside>
      <div class="backdrop" data-sidebar-toggle aria-hidden="true"></div>

      <div class="content">
        <header class="topbar">
          <button class="icon-btn open-btn" type="button" data-sidebar-toggle aria-controls="sidebar" aria-expanded="false" aria-label={t.ui.openMenu}>
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M4 8h16M4 16h16" /></svg>
          </button>
          <div class="topbar-right">
            <nav class="lang" aria-label={t.ui.language}>
              {langs.map((l, i) => (
                <Fragment>
                  {i > 0 && <span aria-hidden="true">·</span>}
                  <a href={`/${l}${rest}`} hreflang={l} lang={l} data-lang={l} aria-current={l === lang ? 'true' : undefined}>{l.toUpperCase()}</a>
                </Fragment>
              ))}
            </nav>
            <button class="icon-btn theme-btn" type="button" data-theme-toggle aria-label={t.ui.toggleTheme}>
              <svg class="moon" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z" /></svg>
              <svg class="sun" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
            </button>
          </div>
        </header>

        <main id="main">
          <slot />
        </main>

        <footer class="foot">
          <span>© {new Date().getFullYear()} {t.siteTitle}</span>
          {/* TODO Diana: do you want a contact address or social links here? Left out on purpose for now. */}
        </footer>
      </div>
    </div>

    <script>
      const root = document.documentElement;
      const isWide = () => window.innerWidth >= 1100;
      const sidebarEl = document.getElementById('sidebar');

      const syncSidebar = () => {
        const open = root.dataset.sidebar === 'open';
        document.querySelectorAll<HTMLButtonElement>('button[data-sidebar-toggle]').forEach((b) => b.setAttribute('aria-expanded', String(open)));
        sidebarEl?.toggleAttribute('inert', !open);
      };
      const setSidebar = (value: 'open' | 'closed') => {
        root.dataset.sidebar = value;
        // Remember the choice on large screens only; on phones it is a drawer.
        if (isWide()) {
          try { localStorage.setItem('sidebar', value); } catch {}
        }
        syncSidebar();
      };

      document.querySelectorAll('[data-sidebar-toggle]').forEach((el) =>
        el.addEventListener('click', () => setSidebar(root.dataset.sidebar === 'open' ? 'closed' : 'open'))
      );
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !isWide() && root.dataset.sidebar === 'open') setSidebar('closed');
      });
      syncSidebar();

      document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
        const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try { localStorage.setItem('theme', next); } catch {}
      });

      // Choosing a language by hand wins over the browser language from now on.
      document.querySelectorAll<HTMLAnchorElement>('a[data-lang]').forEach((a) =>
        a.addEventListener('click', () => {
          try { localStorage.setItem('lang', a.dataset.lang ?? 'en'); } catch {}
        })
      );
    </script>
  </body>
</html>
