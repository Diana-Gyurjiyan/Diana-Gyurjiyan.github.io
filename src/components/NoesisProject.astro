---
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  statusLabel: string;
  date: string;
  dateISO: string;
}

const { lang, statusLabel, date, dateISO } = Astro.props;
const copy = lang === 'nl'
  ? {
      back: '← Bouwstenen',
      title: 'Noesis',
      pronunciation: '/ˈnoʊ.ə.sɪs/',
      tagline: 'Een agentic onderzoeksassistent die artikelen vindt over meerdere bronnen, citaties verkent en bewijs haalt uit de literatuur, met herleidbare bronquotes.',
      openSource: 'Open source',
      workflow: 'Agentic workflow',
      github: 'Bekijk op GitHub ↗',
      clone: 'Kopieer git clone-commando',
      cloned: 'Gekopieerd',
      copyFailed: 'Kopiëren mislukt',
      tabs: ['Probleem & visie', 'Werkwijze', 'Roadmap', 'Simulator', 'Aan de slag'],
      problemTitle: 'Waarom Noesis?',
      problemText: 'Wetenschappelijke literatuur vermenigvuldigt zich in dit AI-tijdperk in een moordend tempo. Het juiste artikel vinden tussen abstracts, trefwoorden en steeds meer publicaties kost tijd, vooral wanneer je zoekt naar een specifieke methode, dataset of technische beperking.',
      bottlenecksTitle: 'Waar zoeken tekortschiet',
      bottlenecks: [
        ['Abstracts vertellen niet het hele verhaal', 'Methodologische beperkingen zijn vaak pas in de volledige paper zichtbaar.'],
        ['Trefwoorden geven veel ruis', 'Een zoekterm kan honderden resultaten opleveren die inhoudelijk niet passen.'],
        ['Handmatig screenen schaalt niet', 'Veel artikelen en PDF-tabbladen één voor één beoordelen kost onnodig veel tijd.'],
      ],
      promiseTitle: 'Van zoekresultaat naar onderbouwde keuze',
      promise: 'Noesis richt zich op inhoudelijke aansluiting: welke claims, methoden en resultaten zijn relevant voor jouw vraag én waarom?',
      goalLabel: 'Doel',
      goal: 'Van papers vinden naar begrijpen wat de literatuur werkelijk onderbouwt.',
      values: [
        ['Herleidbaar bewijs', 'Elke claim, methode, resultaat en beperking hoort bij een letterlijk citaat, met passage, pagina en sectie.'],
        ['Citaties verkennen', 'Volg referenties en citerende artikelen, of laat een snowball vanuit één paper kandidaten voorstellen.'],
        ['Eén bibliotheek zonder duplicaten', 'Dezelfde paper uit meerdere bronnen wordt één keer bewaard, aangevuld met DOI, pdf en abstract.'],
      ],
      workflowTitle: 'Van zoekvraag naar herleidbaar bewijs',
      workflowIntro: 'De pipeline bestaat uit vier stappen:',
      steps: [
        ['01 — Ontdekken', 'Zoek per trefwoord in meerdere bronnen, met optionele query-uitbreiding door een LLM. Dubbele resultaten worden samengevoegd op DOI, arXiv-ID en titel, ook ten opzichte van je bibliotheek.'],
        ['02 — Indexeren', 'Pdf’s worden opgedeeld in passages met lokale Ollama-embeddings (nomic-embed-text), pgvector en full-text search.'],
        ['03 — Bewijs extraheren', 'Claims, methoden, resultaten en beperkingen, elk met een letterlijk citaat. Items waarvan het citaat niet voorkomt, worden verworpen.'],
        ['04 — Vragen en verkennen', 'Stel vragen over geïndexeerde papers met citaten naar passage en pagina, doorzoek de bibliotheek semantisch en verken citaties.'],
      ],
      sourcesLabel: 'Bronnen',
      sources: [['arXiv', false], ['OpenAlex', false], ['Semantic Scholar', false], ['PubMed', false], ['Crossref', false], ['Google Scholar (SerpAPI)', true], ['Web (Tavily)', true]],
      optional: 'optioneel',
      jsonLabel: 'Voorbeeld van een geëxtraheerd bewijsitem (JSON)',
      copyJson: 'Kopieer JSON',
      jsonCopied: 'JSON gekopieerd',
      roadmapTitle: 'Roadmap',
      roadmapIntro: 'Noesis is in actieve ontwikkeling. Vijf fasen, van papers vinden tot onderzoekslacunes signaleren:',
      doneLabel: 'Klaar',
      nextLabel: 'Volgende',
      roadmap: [
        ['Gedeeltelijk klaar', 'Ontdekking', 'Papers vinden en een bibliotheek zonder duplicaten opbouwen.',
          ['Zoeken over meerdere bronnen', 'Citaties en snowball-uitbreiding', 'Ontdubbeling', 'Semantisch zoeken in de bibliotheek'],
          ['Betere retrieval-kwaliteit', 'Reranking']],
        ['Gedeeltelijk klaar', 'Bewijs', 'Bewijs uit papers halen met een herleidbare bron.',
          ['Extractie met bronpassages'],
          ['Achtergrondtaken', 'Review-acties', 'Gestructureerde velden']],
        ['Gepland', 'Synthese', 'Bewijs over papers heen samenbrengen.',
          [],
          ['Normalisatie van claims', 'Relaties tussen claims', 'Echte detectie van tegenstrijdigheden']],
        ['Gepland', 'Epistemiek', 'Duidelijk maken hoe sterk een uitspraak is onderbouwd.',
          [],
          ['Status per uitspraak: gesteld, onderbouwd, afgeleid of onbekend']],
        ['Gepland', 'Onderzoekslacunes', 'Zien wat de literatuur nog niet beantwoordt.',
          [],
          ['Kandidaat-onderzoeksvragen', 'Zoeken naar werk dat een claim weerlegt']],
      ],
      simulatorTitle: 'Bewijsextractie simuleren',
      simulatorIntro: 'Kies een onderzoeksvraag en een voorbeeldartikel om gesimuleerde bewijsextractie te bekijken. Dit is een interface-demo, geen live modelaanroep.',
      topicLabel: 'Onderzoeksvraag',
      paperLabel: 'Voorbeeldartikel',
      topics: [
        ['rag', 'RAG voor lange contexten en weinig geheugen'],
        ['agents', 'Multi-agent samenwerking voor codegeneratie'],
        ['quant', 'LLM-quantisatie op consumenten-GPU’s'],
      ],
      papers: [
        ['paper1', 'Artikel A — Sparse attention voor lange contexten'],
        ['paper2', 'Artikel B — Hallucinaties in multi-turn gesprekken'],
        ['paper3', 'Artikel C — 4-bit-quantisatie op consumenten-GPU’s'],
      ],
      run: 'Simuleer extractie',
      idle: 'De simulatie-uitvoer verschijnt hier.',
      complete: 'VOLTOOID',
      queryMapped: 'Zoekcontext verwerkt',
      fetching: 'Passages ophalen uit',
      extracting: 'Claims, methoden, resultaten en beperkingen extraheren',
      evaluating: 'Citaten controleren tegen de bronpassages',
      score: 'Relevantie',
      rationale: 'Motivatie',
      rationales: {
        strongRag: 'Sluit direct aan op sparse attention en de geheugenbeperking in lange-contexttoepassingen.',
        strongQuant: 'Bespreekt quantisatie en benchmarks op hardware die aansluit bij de onderzoeksvraag.',
        low: 'De paper sluit beperkt aan op de gekozen onderzoeksvraag en randvoorwaarden.',
      },
      evidenceTitle: 'Geëxtraheerd bewijs',
      verified: 'citaat gevonden in passage',
      page: 'p.',
      gsTitle: 'Zelf draaien',
      gsIntro: 'Noesis draait lokaal. Dit heb je nodig en zo start je het.',
      prereqTitle: 'Vereisten',
      prereqs: [
        ['Docker', 'Voor de PostgreSQL-database (met pgvector).'],
        ['Ollama', 'Voor lokale embeddings. Haal het model binnen met:'],
        ['LLM-API-sleutels', 'Stel de sleutels van je gekozen provider in via je shell. Zet nooit sleutels in de repository.'],
      ],
      ollamaCmd: 'ollama pull nomic-embed-text',
      commandsTitle: 'Commando’s',
      copyCommands: 'Kopieer commando’s',
      commandsCopied: 'Commando’s gekopieerd',
      commandNotes: [
        ['make dev', 'Start de ontwikkelomgeving.'],
        ['make db-migrate', 'Past openstaande databasemigraties expliciet toe.'],
      ],
      devWarning: 'De inloggegevens in het compose-bestand zijn alleen bedoeld voor ontwikkeling. Gebruik ze niet in productie.',
      builtBy: 'Een onderzoeksprototype van',
    }
  : {
      back: '← Building blocks',
      title: 'Noesis',
      pronunciation: '/ˈnoʊ.ə.sɪs/',
      tagline: 'An agentic research assistant that finds papers across sources, explores citations, and extracts evidence with traceable source quotes.',
      openSource: 'Open source',
      workflow: 'Agentic workflow',
      github: 'View on GitHub ↗',
      clone: 'Copy git clone command',
      cloned: 'Copied',
      copyFailed: 'Copy failed',
      tabs: ['Problem & vision', 'Workflow', 'Roadmap', 'Simulator', 'Getting started'],
      problemTitle: 'Why Noesis?',
      problemText: 'Scientific literature is growing quickly. Finding the right paper among abstracts, keywords, and a rising number of publications takes time — especially when you are looking for a specific method, dataset, or technical constraint.',
      bottlenecksTitle: 'Where search falls short',
      bottlenecks: [
        ['Abstracts do not tell the whole story', 'Methodological limitations often only become clear in the full paper.'],
        ['Keywords create noise', 'A search term can return hundreds of results that do not fit the actual question.'],
        ['Manual screening does not scale', 'Reviewing papers and PDF tabs one by one takes valuable time.'],
      ],
      promiseTitle: 'From search results to informed choices',
      promise: 'Noesis focuses on substantive fit: which claims, methods, and results matter to your question — and why?',
      goalLabel: 'Goal',
      goal: 'From finding papers to understanding what the literature actually supports.',
      values: [
        ['Traceable evidence', 'Every claim, method, result, and limitation is tied to a verbatim quote, with passage, page, and section.'],
        ['Citation exploration', 'Follow references and citing papers, or let a snowball from one paper suggest candidates.'],
        ['One deduplicated library', 'The same paper from several sources is stored once, with missing DOI, PDF, and abstract filled in.'],
      ],
      workflowTitle: 'From search query to traceable evidence',
      workflowIntro: 'The pipeline has four steps:',
      steps: [
        ['01 — Discover', 'Search per keyword across multiple sources, with optional LLM query expansion. Duplicates merge on DOI, arXiv ID, and title, including against your library.'],
        ['02 — Index', 'PDFs are split into passages with local Ollama embeddings (nomic-embed-text), pgvector, and full-text search.'],
        ['03 — Extract evidence', 'Claims, methods, results, and limitations, each with a verbatim quote. Items whose quote is not found are discarded.'],
        ['04 — Ask and explore', 'Ask questions over indexed papers with citations to passage and page, search the library semantically, and explore citations.'],
      ],
      sourcesLabel: 'Sources',
      sources: [['arXiv', false], ['OpenAlex', false], ['Semantic Scholar', false], ['PubMed', false], ['Crossref', false], ['Google Scholar (SerpAPI)', true], ['Web (Tavily)', true]],
      optional: 'optional',
      jsonLabel: 'Example of an extracted evidence item (JSON)',
      copyJson: 'Copy JSON',
      jsonCopied: 'JSON copied',
      roadmapTitle: 'Roadmap',
      roadmapIntro: 'Noesis is in active development. Five stages, from finding papers to surfacing research gaps:',
      doneLabel: 'Done',
      nextLabel: 'Next',
      roadmap: [
        ['Partly done', 'Discovery', 'Find papers and build a deduplicated library.',
          ['Multi-source search', 'Citations and snowball expansion', 'Deduplication', 'Semantic search over the library'],
          ['Better retrieval quality', 'Reranking']],
        ['Partly done', 'Evidence', 'Pull evidence from papers with a traceable source.',
          ['Extraction with source passages'],
          ['Background jobs', 'Review actions', 'Structured fields']],
        ['Planned', 'Synthesis', 'Bring evidence together across papers.',
          [],
          ['Claim normalization', 'Relations between claims', 'Real contradiction detection']],
        ['Planned', 'Epistemics', 'Make clear how well a statement is supported.',
          [],
          ['Status per statement: stated, supported, inferred, or unknown']],
        ['Planned', 'Research gaps', 'See what the literature does not yet answer.',
          [],
          ['Candidate research questions', 'Search for disconfirming work']],
      ],
      simulatorTitle: 'Simulate evidence extraction',
      simulatorIntro: 'Choose a research question and sample paper to view simulated evidence extraction. This is an interface demo, not a live model call.',
      topicLabel: 'Research question',
      paperLabel: 'Sample paper',
      topics: [
        ['rag', 'RAG for long contexts and limited memory'],
        ['agents', 'Multi-agent collaboration for code generation'],
        ['quant', 'LLM quantization on consumer GPUs'],
      ],
      papers: [
        ['paper1', 'Paper A — Sparse attention for long contexts'],
        ['paper2', 'Paper B — Hallucinations in multi-turn conversations'],
        ['paper3', 'Paper C — 4-bit quantization on consumer GPUs'],
      ],
      run: 'Simulate extraction',
      idle: 'Simulation output will appear here.',
      complete: 'COMPLETE',
      queryMapped: 'Search context mapped',
      fetching: 'Retrieving passages from',
      extracting: 'Extracting claims, methods, results, and limitations',
      evaluating: 'Verifying quotes against source passages',
      score: 'Relevance',
      rationale: 'Rationale',
      rationales: {
        strongRag: 'Directly addresses sparse attention and memory constraints in long-context applications.',
        strongQuant: 'Covers quantization and benchmarks on hardware relevant to the research question.',
        low: 'The paper has limited alignment with the selected question and constraints.',
      },
      evidenceTitle: 'Extracted evidence',
      verified: 'quote found in passage',
      page: 'p.',
      gsTitle: 'Run it yourself',
      gsIntro: 'Noesis runs locally. Here is what you need and how to start it.',
      prereqTitle: 'Prerequisites',
      prereqs: [
        ['Docker', 'For the PostgreSQL database (with pgvector).'],
        ['Ollama', 'For local embeddings. Pull the model with:'],
        ['LLM API keys', 'Set the keys for your chosen provider in your shell. Never commit keys to the repository.'],
      ],
      ollamaCmd: 'ollama pull nomic-embed-text',
      commandsTitle: 'Commands',
      copyCommands: 'Copy commands',
      commandsCopied: 'Commands copied',
      commandNotes: [
        ['make dev', 'Starts the development environment.'],
        ['make db-migrate', 'Applies pending database migrations explicitly.'],
      ],
      devWarning: 'The credentials in the compose file are for development only. Do not use them in production.',
      builtBy: 'A research prototype by',
    };

const cloneCommand = 'git clone https://github.com/Diana-Gyurjiyan/noesis.git';
const setupCommands = `${cloneCommand}
cd noesis
make dev
make db-migrate`;
const jsonOutput = `{
  "paper_id": "arXiv:2403.99120",
  "type": "limitation",
  "text": "Accuracy degrades on sequences beyond 32k tokens.",
  "quote": "performance drops noticeably once the context exceeds 32k tokens",
  "page": 7,
  "section": "Discussion",
  "passage_id": "p-0412"
}`;
---

<article class="noesis wrap" data-noesis data-lang={lang} data-clone={cloneCommand} data-json={jsonOutput} data-setup={setupCommands}>
  <div class="eyebrow"><a href={`/${lang}/building-blocks/`} class="back-link">{copy.back}</a></div>

  <header class="project-header">
    <div class="project-meta">
      <span class="pill">{statusLabel}</span>
      <time datetime={dateISO}>{date}</time>
      <span>{copy.openSource}</span>
      <span>{copy.workflow}</span>
    </div>
    <h1 class="page-title">{copy.title} <span class="pronunciation">{copy.pronunciation}</span></h1>
    <p class="lede">{copy.tagline}</p>
    <div class="project-actions">
      <a class="project-link" href="https://github.com/Diana-Gyurjiyan/noesis" target="_blank" rel="noopener noreferrer">{copy.github}</a>
      <button class="text-button" type="button" data-copy="clone">{copy.clone}</button>
      <span class="copy-status" data-copy-status aria-live="polite"></span>
    </div>
  </header>

  <nav class="project-tabs" aria-label={lang === 'nl' ? 'Noesis-onderdelen' : 'Noesis sections'} role="tablist">
    {copy.tabs.map((label, i) => (
      <button
        type="button"
        id={`noesis-tab-${i}`}
        class="project-tab"
        role="tab"
        aria-selected={i === 0 ? 'true' : 'false'}
        aria-controls={`noesis-panel-${i}`}
        tabindex={i === 0 ? 0 : -1}
        data-tab={i}
      >{label}</button>
    ))}
  </nav>

  <section class="project-panel" id="noesis-panel-0" role="tabpanel" aria-labelledby="noesis-tab-0" data-panel="0">
    <div class="section-heading">
      <p class="eyebrow">{copy.tabs[0]}</p>
      <h2>{copy.problemTitle}</h2>
      <p>{copy.problemText}</p>
    </div>
    <h3 class="subheading">{copy.bottlenecksTitle}</h3>
    <div class="card-grid">
      {copy.bottlenecks.map(([title, description], i) => (
        <article class="plain-card">
          <span class="card-number">0{i + 1}</span>
          <h3>{title}</h3>
          <p>{description}</p>
        </article>
      ))}
    </div>
    <div class="project-note">
      <h3>{copy.promiseTitle}</h3>
      <p>{copy.promise}</p>
    </div>
    <p class="goal"><span class="goal-label">{copy.goalLabel}</span>{copy.goal}</p>
    <div class="card-grid value-grid">
      {copy.values.map(([title, description]) => (
        <article class="value-card">
          <h3>{title}</h3>
          <p>{description}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="project-panel" id="noesis-panel-1" role="tabpanel" aria-labelledby="noesis-tab-1" data-panel="1" hidden>
    <div class="section-heading">
      <p class="eyebrow">{copy.tabs[1]}</p>
      <h2>{copy.workflowTitle}</h2>
      <p>{copy.workflowIntro}</p>
    </div>
    <div class="steps">
      {copy.steps.map(([title, description]) => (
        <article class="step">
          <h3>{title}</h3>
          <p>{description}</p>
        </article>
      ))}
    </div>
    <div class="sources" role="group" aria-label={copy.sourcesLabel}>
      <span class="sources-label">{copy.sourcesLabel}</span>
      {copy.sources.map(([name, isOptional]) => (
        <span class={`chip${isOptional ? ' chip-optional' : ''}`}>{name}{isOptional && <em>{copy.optional}</em>}</span>
      ))}
    </div>
    <div class="json-heading">
      <h3>{copy.jsonLabel}</h3>
      <button class="text-button" type="button" data-copy="json">{copy.copyJson}</button>
    </div>
    <pre class="json-example"><code>{jsonOutput}</code></pre>
    <span class="copy-status" data-json-status aria-live="polite"></span>
  </section>

  <section class="project-panel" id="noesis-panel-2" role="tabpanel" aria-labelledby="noesis-tab-2" data-panel="2" hidden>
    <div class="section-heading">
      <p class="eyebrow">{copy.tabs[2]}</p>
      <h2>{copy.roadmapTitle}</h2>
      <p>{copy.roadmapIntro}</p>
    </div>
    <div class="roadmap">
      {copy.roadmap.map(([status, title, description, done, next], i) => (
        <article class={`roadmap-item${i < 2 ? ' is-active' : ''}`}>
          <div class="roadmap-index">0{i + 1}</div>
          <div>
            <div class="roadmap-meta"><span class={`pill${i < 2 ? ' pill-active' : ''}`}>{status}</span></div>
            <h3>{title}</h3>
            <p>{description}</p>
            <div class="roadmap-lists">
              {done.length > 0 && (
                <div>
                  <h4>{copy.doneLabel}</h4>
                  <ul class="list-done">{done.map((item) => <li>{item}</li>)}</ul>
                </div>
              )}
              <div>
                <h4>{copy.nextLabel}</h4>
                <ul class="list-next">{next.map((item) => <li>{item}</li>)}</ul>
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="project-panel" id="noesis-panel-3" role="tabpanel" aria-labelledby="noesis-tab-3" data-panel="3" hidden>
    <div class="section-heading">
      <p class="eyebrow">{copy.tabs[3]}</p>
      <h2>{copy.simulatorTitle}</h2>
      <p>{copy.simulatorIntro}</p>
    </div>
    <div class="sim-controls">
      {[
        { id: 'topic', label: copy.topicLabel, options: copy.topics },
        { id: 'paper', label: copy.paperLabel, options: copy.papers },
      ].map(({ id, label, options }) => (
        <div class="sim-field">
          <span class="sim-field-label" id={`sim-${id}-label`}>{label}</span>
          <select
            class="native-select"
            data-topic={id === 'topic' ? '' : undefined}
            data-paper={id === 'paper' ? '' : undefined}
            aria-hidden="true"
            tabindex="-1"
          >
            {options.map(([value, optionLabel]) => <option value={value}>{optionLabel}</option>)}
          </select>
          <div class="custom-select" data-custom-select>
            <button
              class="select-trigger"
              type="button"
              role="combobox"
              aria-labelledby={`sim-${id}-label sim-${id}-value`}
              aria-haspopup="listbox"
              aria-expanded="false"
              aria-controls={`sim-${id}-options`}
              data-select-trigger
            >
              <span id={`sim-${id}-value`} data-select-value>{options[0][1]}</span>
              <span class="select-chevron" aria-hidden="true"></span>
            </button>
            <div class="select-options" id={`sim-${id}-options`} role="listbox" aria-labelledby={`sim-${id}-label`} hidden>
              {options.map(([value, optionLabel], i) => (
                <div
                  class="select-option"
                  id={`sim-${id}-option-${i}`}
                  role="option"
                  aria-selected={i === 0 ? 'true' : 'false'}
                  aria-label={optionLabel}
                  tabindex="-1"
                  data-option
                  data-value={value}
                >
                  <span>{optionLabel}</span>
                  <span class="option-check" aria-hidden="true">✓</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
    <button class="project-link sim-run" type="button" data-run>{copy.run}</button>
    <div class="sim-output" aria-live="polite" data-output>{copy.idle}</div>
  </section>

  <section class="project-panel" id="noesis-panel-4" role="tabpanel" aria-labelledby="noesis-tab-4" data-panel="4" hidden>
    <div class="section-heading">
      <p class="eyebrow">{copy.tabs[4]}</p>
      <h2>{copy.gsTitle}</h2>
      <p>{copy.gsIntro}</p>
    </div>
    <h3 class="subheading">{copy.prereqTitle}</h3>
    <div class="card-grid">
      {copy.prereqs.map(([title, description], i) => (
        <article class="plain-card">
          <span class="card-number">0{i + 1}</span>
          <h3>{title}</h3>
          <p>{description}</p>
          {i === 1 && <code class="inline-cmd">{copy.ollamaCmd}</code>}
        </article>
      ))}
    </div>
    <div class="json-heading setup-heading">
      <h3>{copy.commandsTitle}</h3>
      <button class="text-button" type="button" data-copy="setup">{copy.copyCommands}</button>
    </div>
    <pre class="json-example terminal"><code>{setupCommands.split('\n').map((line) => (<span class="cmd-line">{line + '\n'}</span>))}</code></pre>
    <span class="copy-status" data-setup-status aria-live="polite"></span>
    <dl class="command-notes">
      {copy.commandNotes.map(([cmd, note]) => (
        <div><dt><code>{cmd}</code></dt><dd>{note}</dd></div>
      ))}
    </dl>
    <p class="project-note dev-warning">{copy.devWarning}</p>
  </section>

  <footer class="project-footer">
    <span>{copy.builtBy} <a href="https://github.com/Diana-Gyurjiyan" target="_blank" rel="noopener noreferrer">Diana Gyurjiyan</a>.</span>
    <span><time datetime={dateISO}>{date}</time></span>
  </footer>
</article>

<style>
  .noesis {
    --project-accent: var(--ac);
    padding-top: clamp(38px, 6vw, 72px);
  }
  .back-link {
    color: inherit;
    text-decoration: none;
  }
  .back-link:hover,
  .project-footer a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .project-header {
    padding-bottom: clamp(32px, 5vw, 56px);
    border-bottom: 1px solid var(--ln);
  }
  .project-meta,
  .project-actions,
  .roadmap-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px 16px;
    color: var(--mu);
    font-size: 13px;
  }
  .project-meta {
    margin-bottom: 22px;
  }
  .project-meta .pill,
  .roadmap-meta .pill {
    color: var(--project-accent);
    border-color: color-mix(in srgb, var(--project-accent) 45%, var(--ln));
  }
  .pronunciation {
    color: var(--ac);
    font: 400 0.4em/1 var(--sans);
    white-space: nowrap;
    vertical-align: 0.3em;
  }
  .project-actions {
    margin-top: 24px;
  }
