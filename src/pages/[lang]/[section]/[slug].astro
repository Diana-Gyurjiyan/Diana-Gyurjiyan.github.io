---
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import NoesisProject from '../../../components/NoesisProject.astro';
import ElenchosProject from '../../../components/ElenchosProject.astro';
import { langs, ui, sections, type Lang } from '../../../i18n/ui';
import { sectionEntries, entryText } from '../../../lib/content';

// Pages are only built for items that are no longer "forthcoming".
export async function getStaticPaths() {
  const paths = [];
  for (const lang of langs) {
    for (const section of sections) {
      const entries = await sectionEntries(section.collection);
      for (const entry of entries) {
        if (entry.data.status === 'forthcoming') continue;
        const slug = entry.id.split('/').at(-1)!;
        const translatedEntry = lang === 'nl'
          ? await getCollection(section.collection, ({ id }) => id === `nl/${slug}`)
          : [];
        const englishEntry = lang === 'en'
          ? await getCollection(section.collection, ({ id }) => id === `en/${slug}`)
          : [];
        const localizedEntry = translatedEntry[0] ?? englishEntry[0] ?? entry;
        paths.push({ params: { lang, section: section.slug, slug }, props: { entry: localizedEntry } });
      }
    }
  }
  return paths;
}

const lang = Astro.params.lang as Lang;
const section = sections.find((s) => s.slug === Astro.params.section)!;
const { entry } = Astro.props;
const t = ui[lang];
const { Content } = await render(entry);
const text = entryText(lang, entry);
const dateFormat = new Intl.DateTimeFormat(lang === 'nl' ? 'nl-NL' : 'en-GB', { dateStyle: 'long' });
---

<Base lang={lang} title={text.title} description={text.summary}>
  {
    entry.id === 'noesis' ? (
      <NoesisProject lang={lang} statusLabel={t.status[entry.data.status]} date={dateFormat.format(entry.data.date)} dateISO={entry.data.date.toISOString()} />
    ) : entry.id === 'elenchos' ? (
      <ElenchosProject lang={lang} statusLabel={t.status[entry.data.status]} date={dateFormat.format(entry.data.date)} dateISO={entry.data.date.toISOString()} />
    ) : (
      <article class="wrap">
        <div class="eyebrow"><a href={`/${lang}/${section.slug}/`} style="text-decoration:none">← {t.nav[section.nav]}</a></div>
        <h1 class="page-title">{text.title}</h1>
        <div class="article-meta">
          <span class="pill">{t.status[entry.data.status]}</span>
          <time datetime={entry.data.date.toISOString()}>{dateFormat.format(entry.data.date)}</time>
          {entry.data.tags.map((tag) => <span>#{tag}</span>)}
          {entry.data.lang && entry.data.lang !== lang && <span>{t.ui.onlyIn(entry.data.lang)}</span>}
        </div>
        <div class="prose" data-content-lang={lang}>
          <Content />
        </div>
      </article>
    )
  }
</Base>

<script>
  document.querySelectorAll<HTMLElement>('.prose[data-content-lang="nl"] [data-footnotes] > h2').forEach((heading) => {
    heading.textContent = 'Voetnoten';
  });
</script>
