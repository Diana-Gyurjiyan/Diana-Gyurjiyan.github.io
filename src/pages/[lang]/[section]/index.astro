---
import Base from '../../../layouts/Base.astro';
import EntryRow from '../../../components/EntryRow.astro';
import { langs, ui, sections, type Lang } from '../../../i18n/ui';
import { sectionEntries, entryHref } from '../../../lib/content';

export function getStaticPaths() {
  return langs.flatMap((lang) => sections.map((section) => ({ params: { lang, section: section.slug } })));
}

const lang = Astro.params.lang as Lang;
const section = sections.find((s) => s.slug === Astro.params.section)!;
const t = ui[lang];
const copy = t.sections[section.nav];
const entries = await sectionEntries(section.collection);
---

<Base lang={lang} title={copy.title} description={copy.intro}>
  <section class="wrap">
    <div class="eyebrow">{t.nav[section.nav]}</div>
    <h1 class="page-title">{copy.title}</h1>
    <p class="lede">{copy.intro}</p>
  </section>

  <section class="wrap">
    {
      entries.map((entry, i) => (
        <EntryRow
          label={`0${i + 1}`}
          title={entry.data.title}
          summary={entry.data.summary}
          status={entry.data.status}
          statusLabel={t.status[entry.data.status]}
          href={entryHref(lang, section, entry)}
          note={entry.data.lang && entry.data.lang !== lang ? t.ui.onlyIn(entry.data.lang) : undefined}
        />
      ))
    }
  </section>
</Base>
